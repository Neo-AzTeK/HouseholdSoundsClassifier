# Virtual environment & Python bytecode
.venv/
__pycache__/
*.py[cod]
*.log

# Audio dataset & preprocessing caches (1.4+ GB, re-downloadable via dataset.py)
data/audio/
data/cache/
data/metadata/
data/inbox/

# Local candidates & historical checkpoints
artifacts/*.pt
artifacts/*.metrics.json
artifacts/*.npy
artifacts/*.har
artifacts/archive/

# Explicitly track the active production model, onnx, and configs
!artifacts/household_sound.pt
!artifacts/household_sound.metrics.json
!artifacts/household_sound.onnx
!artifacts/household_sound.alls
!artifacts/household_sound.hef
